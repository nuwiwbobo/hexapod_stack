<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hexapod_bringup</name>
  <version>1.0.0</version>
  <description>Launch files for the hexapod locomotion stack</description>
  <maintainer email="dev@hexapod.dev">hexapod</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>hexapod_ik</exec_depend>
  <exec_depend>hexapod_gait</exec_depend>
  <exec_depend>hexapod_servo</exec_depend>
  <exec_depend>hexapod_control</exec_depend>
  <exec_depend>hexapod_description</exec_depend>
  <exec_depend>rclcpp_components</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
